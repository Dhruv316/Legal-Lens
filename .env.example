# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# Only needed for the Products / Entities map views.
# Restrict this key to your domain in Google Cloud Console before using it anywhere public.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Only needed if you flip DEMO_MODE to false in lib/demoConfig.js and run the real backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
